# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/code_a_nova?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=super_secret_jwt_key_code_a_nova_2026_xyz

# Nodemailer SMTP Configuration (Brevo or Gmail)
# Option 1: Brevo (Recommended)
EMAIL_SERVICE=brevo
BREVO_API_KEY=xkeysib-your_brevo_api_key_xyz
BREVO_SMTP_USER=your_brevo_login_email@smtp-brevo.com
